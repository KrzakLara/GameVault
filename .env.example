APP_NAME=GameVault
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=gamevault
DB_USERNAME=gamevault
DB_PASSWORD=gamevault_local_dev
# READ COMMITTED keeps the SKIP LOCKED allocator free of gap-lock deadlocks (docs/architecture.md).
DB_ISOLATION_LEVEL="READ COMMITTED"
# Seconds a statement may wait for a row lock before it fails and is retried.
DB_LOCK_WAIT_TIMEOUT=5

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# GameVault
GAMEVAULT_LOW_STOCK_THRESHOLD=3
GAMEVAULT_CHECKOUT_RATE_LIMIT=10
GAMEVAULT_REVEAL_RATE_LIMIT=10
GAMEVAULT_FULFILLMENT_LATENCY_MS=1500
# Keep: job timeout (30 s) < lease < queue retry_after (90 s). Asserted by the test suite.
GAMEVAULT_FULFILLMENT_LEASE_SECONDS=60
GAMEVAULT_FULFILLMENT_MAX_ATTEMPTS=10
GAMEVAULT_STUCK_AFTER_MINUTES=10
GAMEVAULT_OUTBOX_LEASE_SECONDS=120
CHEAPSHARK_ENABLED=true
CHEAPSHARK_BASE_URL=https://www.cheapshark.com/api/1.0
